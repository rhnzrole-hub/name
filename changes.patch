diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/RetainedMessages.java b/TMessagesProj/src/main/java/org/telegram/messenger/RetainedMessages.java
new file mode 100644
index 00000000..115d9d16
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/RetainedMessages.java
@@ -0,0 +1,169 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import java.util.ArrayList;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** Message contents stay in the account database; rendering reads only the in-memory index. */
+public final class RetainedMessages {
+    private RetainedMessages() {}
+
+    private static final ConcurrentHashMap<Integer, State> states = new ConcurrentHashMap<>();
+
+    private static final class State {
+        final int account;
+        final ConcurrentHashMap<Long, Set<Integer>> ids = new ConcurrentHashMap<>();
+        final AtomicBoolean preloadScheduled = new AtomicBoolean();
+        final AtomicBoolean notificationPending = new AtomicBoolean();
+        // Accessed only on this account's storage queue.
+        boolean loaded;
+        SharedPreferences preferences;
+
+        State(int account) {
+            this.account = account;
+        }
+
+        void load() {
+            if (loaded) return;
+            preferences = ApplicationLoader.applicationContext.getSharedPreferences(
+                    "retained_deleted_messages_" + account, Context.MODE_PRIVATE);
+            for (Map.Entry<String, ?> entry : preferences.getAll().entrySet()) {
+                if (!Boolean.TRUE.equals(entry.getValue())) continue;
+                String key = entry.getKey();
+                int separator = key.indexOf(':');
+                if (separator < 0) continue;
+                try {
+                    long channelId = Long.parseLong(key.substring(0, separator));
+                    int messageId = Integer.parseInt(key.substring(separator + 1));
+                    if (channelId >= 0 && messageId > 0) {
+                        ids.computeIfAbsent(channelId, unused -> ConcurrentHashMap.newKeySet()).add(messageId);
+                    }
+                } catch (NumberFormatException ignored) {
+                }
+            }
+            loaded = true;
+        }
+
+        void notifyChanged() {
+            if (notificationPending.compareAndSet(false, true)) {
+                AndroidUtilities.runOnUIThread(() -> {
+                    notificationPending.set(false);
+                    NotificationCenter.getInstance(account)
+                            .postNotificationName(NotificationCenter.retainedMessagesChanged);
+                }, 16);
+            }
+        }
+    }
+
+    private static void onStorageQueue(int account, Runnable task) {
+        DispatchQueue2 queue = MessagesStorage.getInstance(account).getStorageQueue();
+        if (Thread.currentThread() == queue) {
+            task.run();
+        } else {
+            queue.postRunnable(task);
+        }
+    }
+
+    private static State state(int account) {
+        return states.computeIfAbsent(account, State::new);
+    }
+
+    public static void preload(int account) {
+        State state = state(account);
+        if (state.preloadScheduled.compareAndSet(false, true)) {
+            onStorageQueue(account, () -> {
+                state.load();
+                if (!state.ids.isEmpty()) state.notifyChanged();
+            });
+        }
+    }
+
+    private static String key(long channelId, int messageId) {
+        return channelId + ":" + messageId;
+    }
+
+    public static void record(int account, long channelId, ArrayList<Integer> ids) {
+        if (channelId < 0 || ids == null || ids.isEmpty()) return;
+        ArrayList<Integer> copy = new ArrayList<>(ids);
+        onStorageQueue(account, () -> {
+            State state = state(account);
+            state.load();
+            Set<Integer> retained = state.ids.computeIfAbsent(channelId, unused -> ConcurrentHashMap.newKeySet());
+            SharedPreferences.Editor editor = null;
+            for (int id : copy) {
+                if (id > 0 && retained.add(id)) {
+                    if (editor == null) editor = state.preferences.edit();
+                    editor.putBoolean(key(channelId, id), true);
+                }
+            }
+            if (editor != null) {
+                editor.apply();
+                state.notifyChanged();
+            }
+        });
+    }
+
+    public static boolean isDeleted(MessageObject message) {
+        if (message == null || message.messageOwner == null || message.getId() <= 0
+                || message.scheduled || message.isQuickReply() || message.isWelcomeMessage()
+                || DialogObject.isEncryptedDialog(message.getDialogId())) {
+            return false;
+        }
+        State state = states.get(message.currentAccount);
+        if (state == null) return false;
+        long channelId = message.messageOwner.peer_id == null ? 0 : message.messageOwner.peer_id.channel_id;
+        Set<Integer> ids = state.ids.get(channelId);
+        return ids != null && ids.contains(message.getId());
+    }
+
+    public static void forget(int account, long channelId, ArrayList<Integer> ids) {
+        if (ids == null || ids.isEmpty()) return;
+        ArrayList<Integer> copy = new ArrayList<>(ids);
+        onStorageQueue(account, () -> {
+            State state = state(account);
+            state.load();
+            Set<Integer> retained = state.ids.get(channelId);
+            if (retained == null) return;
+            SharedPreferences.Editor editor = null;
+            for (int id : copy) {
+                if (retained.remove(id)) {
+                    if (editor == null) editor = state.preferences.edit();
+                    editor.remove(key(channelId, id));
+                }
+            }
+            if (editor != null) {
+                editor.apply();
+                state.notifyChanged();
+            }
+        });
+    }
+
+    /** Called only on the account's storage queue, after earlier record/forget operations. */
+    public static String keepDeletedSql(int account, long channelId) {
+        State state = state(account);
+        state.load();
+        Set<Integer> retained = state.ids.get(channelId);
+        if (retained == null || retained.isEmpty()) return "";
+        StringBuilder ids = new StringBuilder();
+        for (int id : retained) {
+            if (ids.length() > 0) ids.append(',');
+            ids.append(id);
+        }
+        return " AND mid NOT IN (" + ids + ")";
+    }
+
+    public static void clear(int account) {
+        onStorageQueue(account, () -> {
+            State state = state(account);
+            state.load();
+            state.ids.clear();
+            state.preferences.edit().clear().apply();
+            state.notifyChanged();
+        });
+    }
+}
