+                getMessagesController().putUser(cell.getUser(), false);
+            } else if (cell.getChat() != null) {
+                getMessagesController().putChat(cell.getChat(), false);
+            }
+        }
+        Bundle args = new Bundle();
+        if (DialogObject.isEncryptedDialog(peerId)) {
+            TLRPC.EncryptedChat secret = getMessagesController().getEncryptedChat(DialogObject.getEncryptedChatId(peerId));
+            if (secret == null) {
+                return false;
+            }
+            args.putLong("user_id", secret.user_id);
+            args.putLong("dialog_id", peerId);
+        } else if (DialogObject.isUserDialog(peerId)) {
+            args.putLong("user_id", peerId);
+        } else {
+            args.putLong("chat_id", -peerId);
+        }
+        args.putBoolean("open_bio", true);
