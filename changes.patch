diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessageEditsHistory.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessageEditsHistory.java
new file mode 100644
index 00000000..e0f29a63
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessageEditsHistory.java
@@ -0,0 +1,66 @@
+package org.telegram.messenger;
+
+import org.telegram.tgnet.SerializedData;
+import org.telegram.tgnet.TLRPC;
+
+import java.security.MessageDigest;
+import java.util.ArrayList;
+
+public final class MessageEditsHistory {
+    public static final int PAGE_SIZE = 50;
+    private MessageEditsHistory() {}
+
+    public static final class Entry {
+        public final long sequence;
+        public final int date;
+        public final boolean original;
+        public final TLRPC.Message message;
+
+        public Entry(long sequence, int date, boolean original, TLRPC.Message message) {
+            this.sequence = sequence;
+            this.date = date;
+            this.original = original;
+            this.message = message;
+        }
+    }
+
+    public static final class Page {
+        public final ArrayList<Entry> entries = new ArrayList<>();
+        public boolean hasMore;
+    }
+
+    public static boolean canRecord(TLRPC.Message before, TLRPC.Message after) {
+        return before instanceof TLRPC.TL_message && after instanceof TLRPC.TL_message
+                && !(before instanceof TLRPC.TL_message_secret) && !(after instanceof TLRPC.TL_message_secret)
+                && before.id > 0 && before.id == after.id
+                && MessageObject.getDialogId(before) != 0
+                && MessageObject.getDialogId(before) == MessageObject.getDialogId(after)
+                && !DialogObject.isEncryptedDialog(MessageObject.getDialogId(before));
+    }
+
+    /** Content only: read state, counters, reactions and edit timestamps cannot create duplicates. */
+    public static String contentKey(TLRPC.Message message) {
+        SerializedData data = new SerializedData();
+        try {
+            data.writeString(message.message == null ? "" : message.message);
+            data.writeInt32(message.entities == null ? 0 : message.entities.size());
+            if (message.entities != null) {
+                for (TLRPC.MessageEntity entity : message.entities) entity.serializeToStream(data);
+            }
+            boolean hasMedia = message.media != null && !(message.media instanceof TLRPC.TL_messageMediaEmpty);
+            data.writeBool(hasMedia);
+            if (hasMedia) message.media.serializeToStream(data);
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(data.toByteArray());
+            StringBuilder key = new StringBuilder(64);
+            final char[] hex = "0123456789abcdef".toCharArray();
+            for (byte value : digest) {
+                key.append(hex[(value & 255) >>> 4]).append(hex[value & 15]);
+            }
+            return key.toString();
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        } finally {
+            data.cleanup();
+        }
+    }
+}
