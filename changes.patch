+public final class TelegramPlusFolderActions {
+    private TelegramPlusFolderActions() {}
+    public static void markRead(MessagesController controller, TLRPC.Dialog dialog) {
+        if (dialog == null || dialog instanceof TLRPC.TL_dialogFolder) return;
+        if (controller.isForum(dialog.id) || controller.isMonoForumWithManageRights(dialog.id)) {
+            controller.markAllTopicsAsRead(dialog.id);
+        }
