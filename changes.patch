+            @Override public void run() {
+                if (cancelled[0] || getParentActivity() == null || owner != getUserConfig().getClientUserId()) {
+                    progress.dismiss(); return;
+                }
+                if (android.os.SystemClock.elapsedRealtime() - started > 120_000) {
+                    progress.dismiss();
+                    BulletinFactory.of(DialogsActivity.this).createSimpleBulletin(R.raw.error, "Could not load all chats. Try again.").show();
+                    return;
+                }
+                boolean pending = false;
+                int[] folders = hiddenScope ? new int[]{0, 1} : new int[]{scopeFolder};
+                for (int folder : folders) {
+                    if (!getMessagesController().isServerDialogsEndReached(folder)) {
+                        pending = true;
+                        if (!getMessagesController().isLoadingDialogs(folder)) {
+                            getMessagesController().loadDialogs(folder, -1, 100, !getMessagesController().isDialogsEndReached(folder));
+                        }
+                    }
+                }
+                if (pending) { AndroidUtilities.runOnUIThread(this, 400); return; }
+                ArrayList<TLRPC.Dialog> source = hiddenScope ? getMessagesController().getAllDialogs() : getMessagesController().getDialogs(scopeFolder);
+                ArrayList<TLRPC.Dialog> targets = new ArrayList<>();
+                for (TLRPC.Dialog dialog : org.telegram.messenger.TelegramPlusFolders.visibleDialogs(
+                        getMessagesController(), source, category, currentAccount, hiddenScope)) {
