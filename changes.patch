@@ -0,0 +1,77 @@
+package org.telegram.messenger;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.HashSet;
+import org.telegram.ui.Storage.CacheModel;
+
+/** Cache-only deletion on the file queue; no messages or server dialogs are deleted. */
+public final class TelegramPlusFolderCache {
+    public static final class Result {
+        public long bytes;
+        public int files, skipped, failures;
+        public boolean lookupFailed;
+    }
+    private TelegramPlusFolderCache() {}
+
+    public static boolean isManagedCacheFile(File file) {
+        try {
+            String path = file.getCanonicalPath();
+            for (int type = FileLoader.MEDIA_DIR_IMAGE; type <= FileLoader.MEDIA_DIR_STORIES; type++) {
+                File directory = FileLoader.checkDirectory(type);
+                if (directory != null && path.startsWith(directory.getCanonicalPath() + File.separator)) return true;
+            }
+        } catch (Exception error) { FileLog.e(error); }
+        return false;
+    }
+    private static void deleteFile(File file, Result result, HashSet<String> visited) {
+        try {
+            if (!isManagedCacheFile(file) || !visited.add(file.getCanonicalPath()) || !file.isFile()) return;
+            long size = file.length();
+            if (file.delete()) { result.bytes += size; result.files++; } else result.failures++;
+        } catch (Exception error) { result.failures++; FileLog.e(error); }
+    }
+    public static void clear(int account, HashSet<Long> dialogs, Utilities.Callback<Result> callback) {
+        FileLoader loader = FileLoader.getInstance(account);
+        MessageObject playing = MediaController.getInstance().getPlayingMessageObject();
+        final MessageObject playingSnapshot = playing != null && playing.currentAccount == account ? playing : null;
+        loader.getFileDatabase().getCachedFilesForDialogs(dialogs, files -> {
+            if (files == null) {
+                Result result = new Result(); result.lookupFailed = true; callback.run(result); return;
+            }
+            loader.getFileLoaderQueue().postRunnable(() -> {
+                Result result = new Result();
+                ArrayList<CacheModel.FileInfo> removed = new ArrayList<>();
+                HashSet<String> visited = new HashSet<>();
+                String playingPath = null;
+                try {
+                    if (playingSnapshot != null) playingPath = loader.getPathToMessage(playingSnapshot.messageOwner).getCanonicalPath();
+                } catch (Exception error) { FileLog.e(error); }
+                for (File file : files) {
+                    try {
+                        File encrypted = new File(file.getAbsolutePath() + ".enc");
+                        String path = file.getCanonicalPath();
+                        if (!isManagedCacheFile(file) || path.equals(playingPath) || encrypted.getCanonicalPath().equals(playingPath) ||
+                                AutoDeleteMediaTask.usingFilePaths.contains(file.getAbsolutePath()) ||
+                                AutoDeleteMediaTask.usingFilePaths.contains(encrypted.getAbsolutePath()) ||
+                                loader.isLoadingFile(file.getName()) || loader.isLoadingFilePath(file)) {
+                            result.skipped++; continue;
+                        }
+                        deleteFile(file, result, visited);
+                        deleteFile(encrypted, result, visited);
+                        deleteFile(new File(file.getParentFile(), "q_" + file.getName()), result, visited);
+                        if (!file.exists() && !encrypted.exists()) {
+                            deleteFile(new File(FileLoader.getInternalCacheDir(), file.getName() + ".enc.key"), result, visited);
+                            removed.add(new CacheModel.FileInfo(file));
+                        }
+                    } catch (Exception error) { result.failures++; FileLog.e(error); }
+                }
+                if (!removed.isEmpty()) loader.getFileDatabase().removeFiles(removed);
+                AndroidUtilities.runOnUIThread(() -> {
+                    loader.checkCurrentDownloadsFiles();
+                    callback.run(result);
+                });
+            });
+        });
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/TelegramPlusFolderMembership.java b/TMessagesProj/src/main/java/org/telegram/messenger/TelegramPlusFolderMembership.java
new file mode 100644
index 0000000..8cd9335
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/TelegramPlusFolderMembership.java
@@ -0,0 +1,94 @@
+package org.telegram.messenger;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Set;
+
+/** Explicit per-dialog category membership, independent of server folders and chat types. */
+public final class TelegramPlusFolderMembership {
+    private static final HashMap<String, State> accounts = new HashMap<>();
+    private static class State {
+        final ArrayList<HashSet<Long>> included = new ArrayList<>();
+        final ArrayList<HashSet<Long>> excluded = new ArrayList<>();
+    }
+    private TelegramPlusFolderMembership() {}
+    private static String key(int account, int category, boolean include) {
+        return "telegram_plus_folder_" + UserConfig.getInstance(account).getClientUserId() + "_" + category + (include ? "_include" : "_exclude");
+    }
+    private static HashSet<Long> decode(Set<String> saved) {
+        HashSet<Long> result = new HashSet<>();
+        for (String value : saved) {
+            try { result.add(Long.parseLong(value)); } catch (NumberFormatException ignored) {}
+        }
+        return result;
+    }
+    private static State state(int account) {
+        String identity = account + ":" + UserConfig.getInstance(account).getClientUserId();
+        State result = accounts.get(identity);
+        if (result == null) {
+            result = new State();
+            for (int category = 0; category < 6; category++) {
+                result.included.add(decode(MessagesController.getMainSettings(account).getStringSet(key(account, category, true), Collections.emptySet())));
+                result.excluded.add(decode(MessagesController.getMainSettings(account).getStringSet(key(account, category, false), Collections.emptySet())));
+            }
+            accounts.put(identity, result);
+        }
+        return result;
+    }
+    private static HashSet<String> encode(Set<Long> source) {
+        HashSet<String> result = new HashSet<>();
+        for (long id : source) result.add(Long.toString(id));
+        return result;
+    }
+    public static final class Snapshot {
+        private final HashSet<Long> included, excluded;
+        private Snapshot(State state, int category) {
+            included = new HashSet<>(state.included.get(category));
+            excluded = new HashSet<>(state.excluded.get(category));
+        }
+        public boolean isEmpty() { return included.isEmpty() && excluded.isEmpty(); }
+        public boolean contains(long id, boolean natural) {
+            return (excluded.isEmpty() || !excluded.contains(id)) && (natural || !included.isEmpty() && included.contains(id));
+        }
+    }
+    public static synchronized Snapshot snapshot(int account, int category) {
+        if (category < 0 || category >= 6) throw new IllegalArgumentException("Invalid category");
+        return new Snapshot(state(account), category);
+    }
+    public static synchronized Snapshot[] snapshots(int account) {
+        State state = state(account);
+        Snapshot[] result = new Snapshot[6];
+        for (int i = 0; i < result.length; i++) result[i] = new Snapshot(state, i);
+        return result;
+    }
+    public static synchronized int membership(int account, int category, long dialogId) {
+        if (category < 0 || category >= 6) return 0;
+        State state = state(account);
+        if (state.excluded.get(category).contains(dialogId)) return -1;
+        return state.included.get(category).contains(dialogId) ? 1 : 0;
+    }
+    public static synchronized boolean hasOverrides(int account, int category) {
+        if (category < 0 || category >= 6) return false;
+        State state = state(account);
+        return !state.included.get(category).isEmpty() || !state.excluded.get(category).isEmpty();
+    }
+    public static synchronized boolean hasAnyOverrides(int account) {
+        for (int category = 0; category < 6; category++) if (hasOverrides(account, category)) return true;
+        return false;
+    }
+    public static synchronized void setMembership(int account, int category, ArrayList<Long> dialogs, boolean include) {
+        if (category < 0 || category >= 6) throw new IllegalArgumentException("Invalid category");
+        State state = state(account);
+        for (long id : dialogs) {
+            if (id == 0 || DialogObject.isFolderDialogId(id)) continue;
+            state.included.get(category).remove(id);
+            state.excluded.get(category).remove(id);
+            (include ? state.included : state.excluded).get(category).add(id);
+        }
+        MessagesController.getMainSettings(account).edit()
+                .putStringSet(key(account, category, true), encode(state.included.get(category)))
+                .putStringSet(key(account, category, false), encode(state.excluded.get(category))).apply();
+    }
+}
