--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/TelegramPlusDownloadResume.java
@@ -0,0 +1,53 @@
+package org.telegram.messenger;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Compatible missing-range checkpoints, shared across cancel/restart operation instances. */
+public final class TelegramPlusDownloadResume {
+    private static final Object[] locks = new Object[64];
+    static { for (int i = 0; i < locks.length; i++) locks[i] = new Object(); }
+    private TelegramPlusDownloadResume() {}
+    public static Object lockFor(File file) {
+        return locks[(file.getAbsolutePath().hashCode() & 0x7fffffff) % locks.length];
+    }
+    public static ArrayList<long[]> read(RandomAccessFile input, File checkpoint, long total, File partial) throws IOException {
+        synchronized (lockFor(checkpoint)) {
+            long length = input.length();
+            long actualLength = partial.exists() ? partial.length() : 0;
+            if (total <= 0 || length < 4 || (length - 4) % 16 != 0) return null;
+            input.seek(0);
+            int count = input.readInt();
+            if (count < 0 || count > (length - 4) / 16 || count > 1_000_000) return null;
+            ArrayList<long[]> result = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                long start = input.readLong(), end = input.readLong();
+                if (start < 0 || start >= end || end > total) return null;
+                result.add(new long[]{start, end});
+            }
+            // Native addPart can insert a split at index zero, so valid saved maps need not be ordered.
+            result.sort((a, b) -> Long.compare(a[0], b[0]));
+            long previousEnd = 0;
+            for (long[] range : result) {
+                if (range[0] < previousEnd) return null;
+                // Every claimed downloaded interval must be inside the actual temporary file.
+                if (range[0] > previousEnd && range[0] > actualLength) return null;
+                previousEnd = range[1];
+            }
+            if (previousEnd < total && actualLength < total) return null;
+            return result;
+        }
+    }
+    public static void write(RandomAccessFile output, File checkpoint, List<long[]> missing) throws IOException {
+        synchronized (lockFor(checkpoint)) {
+            output.seek(0);
+            output.writeInt(missing.size());
+            for (long[] range : missing) { output.writeLong(range[0]); output.writeLong(range[1]); }
+            output.setLength(4L + 16L * missing.size());
+            output.getFD().sync();
+        }
+    }
+}
