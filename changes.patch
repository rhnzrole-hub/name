+package org.telegram.messenger;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Set;
+
+/** Device-local hidden dialog IDs, persisted separately for each account. */
+public final class TelegramPlusHiddenChats {
+    private static final HashMap<String, HashSet<Long>> accounts = new HashMap<>();
+    private static final String KEY = "telegram_plus_hidden_dialogs";
+    private TelegramPlusHiddenChats() {}
+
+    private static HashSet<Long> ids(int account) {
+        String identity = account + ":" + UserConfig.getInstance(account).getClientUserId();
+        HashSet<Long> result = accounts.get(identity);
+        if (result == null) {
+            result = new HashSet<>();
+            Set<String> saved = MessagesController.getMainSettings(account).getStringSet(KEY + "_" + UserConfig.getInstance(account).getClientUserId(), Collections.emptySet());
+            for (String value : saved) {
+                try { result.add(Long.parseLong(value)); } catch (NumberFormatException ignored) {}
+            }
+            accounts.put(identity, result);
+        }
+        return result;
+    }
+
+    public static synchronized HashSet<Long> snapshot(int account) {
+        return new HashSet<>(ids(account));
+    }
+
+    public static synchronized boolean isHidden(int account, long dialogId) {
+        return ids(account).contains(dialogId);
+    }
+
+    public static synchronized boolean hasHidden(int account) {
+        return !ids(account).isEmpty();
+    }
+
+    public static synchronized void setHidden(int account, ArrayList<Long> dialogIds, boolean hide) {
+        HashSet<Long> values = ids(account);
+        for (long id : dialogIds) {
+            if (id == 0 || DialogObject.isFolderDialogId(id)) continue;
+            if (hide) values.add(id); else values.remove(id);
+        }
+        HashSet<String> saved = new HashSet<>();
+        for (long id : values) saved.add(Long.toString(id));
+        MessagesController.getMainSettings(account).edit().putStringSet(KEY + "_" + UserConfig.getInstance(account).getClientUserId(), saved).apply();
