+                            for (; offset < end; offset++) org.telegram.messenger.TelegramPlusFolderActions.markRead(getMessagesController(), targets.get(offset));
+                            if (offset < targets.size()) { AndroidUtilities.runOnUIThread(this, 16); return; }
