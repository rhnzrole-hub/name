diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/TelegramPlusMediaInfo.java b/TMessagesProj/src/main/java/org/telegram/messenger/TelegramPlusMediaInfo.java
new file mode 100644
index 0000000..a199702
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/TelegramPlusMediaInfo.java
@@ -0,0 +1,87 @@
+package org.telegram.messenger;
+
+import org.telegram.tgnet.TLRPC;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/** Shows metadata already supplied by Telegram; does not download or probe media. */
+public final class TelegramPlusMediaInfo {
+    private TelegramPlusMediaInfo() {}
+    public static boolean hasMedia(MessageObject message) {
+        return message != null && message.messageOwner != null &&
+                (message.getDocument() != null || message.getPhoto() != null);
+    }
+    private static String clean(String value) {
+        return value == null ? "" : value.replace('\r', ' ').replace('\n', ' ').trim();
+    }
+    private static void row(StringBuilder out, String title, String value) {
+        if (!clean(value).isEmpty()) out.append(title).append(": ").append(clean(value)).append('\n');
+    }
+    private static String date(int seconds) {
+        if (seconds <= 0) return "Not provided";
+        SimpleDateFormat format = new SimpleDateFormat("dd.MM.yyyy HH:mm:ss z", Locale.getDefault());
+        format.setTimeZone(TimeZone.getDefault());
+        return format.format(new Date(seconds * 1000L));
+    }
+    private static String duration(double seconds) {
+        long milliseconds = Math.round(seconds * 1000);
+        long total = milliseconds / 1000;
+        String clock = String.format(Locale.ROOT, "%02d:%02d:%02d", total / 3600, total / 60 % 60, total % 60);
+        return milliseconds % 1000 == 0 ? clock : clock + String.format(Locale.ROOT, ".%03d", milliseconds % 1000);
+    }
+    public static String build(MessageObject message) {
+        if (!hasMedia(message)) return "Media details are not available.";
+        StringBuilder out = new StringBuilder();
+        TLRPC.Document document = message.getDocument();
+        long bytes = 0;
+        int width = 0, height = 0;
+        double seconds = 0;
+        String name = "", mime = "", title = "", performer = "";
+        boolean generatedName = false;
+        if (document != null) {
+            name = FileLoader.getDocumentFileName(document);
+            if (clean(name).isEmpty()) { name = message.getFileName(); generatedName = true; }
+            bytes = document.size;
+            mime = document.mime_type;
+            for (TLRPC.DocumentAttribute attribute : document.attributes) {
+                if ((long) attribute.w * attribute.h > (long) width * height && attribute.w > 0 && attribute.h > 0) {
+                    width = attribute.w; height = attribute.h;
+                }
+                if (!Double.isNaN(attribute.duration) && !Double.isInfinite(attribute.duration) && attribute.duration > seconds) seconds = attribute.duration;
+                if (attribute instanceof TLRPC.TL_documentAttributeAudio) {
+                    title = attribute.title; performer = attribute.performer;
+                }
+            }
+        } else {
+            TLRPC.Photo photo = message.getPhoto();
+            TLRPC.PhotoSize best = null;
+            for (TLRPC.PhotoSize size : photo.sizes) {
+                if (size.w > 0 && size.h > 0 && (best == null || (long) size.w * size.h > (long) best.w * best.h)) best = size;
+            }
+            if (best != null) {
+                name = FileLoader.getAttachFileName(best);
+                width = best.w; height = best.h; bytes = best.size;
+                if (best instanceof TLRPC.TL_photoSizeProgressive) {
+                    for (int size : ((TLRPC.TL_photoSizeProgressive) best).sizes) bytes = Math.max(bytes, size);
+                }
+                if (bytes <= 0 && best.bytes != null) bytes = best.bytes.length;
+            }
+            generatedName = true;
+            mime = "Not provided (Telegram photo)";
+        }
+        row(out, generatedName ? "File name (Telegram)" : "File name", clean(name).isEmpty() ? "Not provided" : name);
+        row(out, "Size", bytes > 0 ? AndroidUtilities.formatFileSize(bytes) + " (" + bytes + " bytes)" : "Not provided");
+        row(out, "MIME type", clean(mime).isEmpty() ? "Not provided" : mime);
+        if (width > 0 && height > 0) row(out, "Dimensions", width + " × " + height + " px");
+        if (seconds > 0) row(out, "Duration", duration(seconds));
+        row(out, "Audio title", title);
+        row(out, "Artist", performer);
+        row(out, "Sent", date(message.messageOwner.date));
+        if (message.messageOwner.edit_date > 0) row(out, "Edited", date(message.messageOwner.edit_date));
+        if (message.messageOwner.fwd_from != null && message.messageOwner.fwd_from.date > 0) row(out, "Original sent", date(message.messageOwner.fwd_from.date));
+        row(out, "Message ID", String.valueOf(message.getId()));
+        return out.toString().trim();
+    }
+}
