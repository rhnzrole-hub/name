+                }
+                progress.setCanCancel(false);
+                if (clearCache) {
+                    progress.setMessage("Clearing cache…");
+                    java.util.HashSet<Long> ids = new java.util.HashSet<>();
+                    for (TLRPC.Dialog dialog : targets) ids.add(dialog.id);
+                    org.telegram.messenger.TelegramPlusFolderCache.clear(currentAccount, ids, result -> {
+                        progress.dismiss();
+                        if (getParentActivity() == null) return;
+                        String text = result.lookupFailed ? "Could not clear cache. Try again." :
+                                "Cache cleared: " + AndroidUtilities.formatFileSize(result.bytes) +
+                                (result.skipped > 0 ? " · Skipped: " + result.skipped : "") +
+                                (result.failures > 0 ? " · Could not delete: " + result.failures : "");
+                        BulletinFactory.of(DialogsActivity.this).createSimpleBulletin(result.lookupFailed ? R.raw.error : R.raw.ic_delete, text).show();
+                        getNotificationCenter().postNotificationName(NotificationCenter.dialogsNeedReload);
+                    });
+                } else {
