@@ -0,0 +1,68 @@
+package org.telegram.ui.Components;
+
+import android.content.Context;
+
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.MessageEditsHistory;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+
+public final class MessageEditsHistoryDialog {
+    private MessageEditsHistoryDialog() {}
+
+    public static void show(BaseFragment fragment, MessageObject message) {
+        showPage(fragment, message.currentAccount, message.getDialogId(), message.getId(), 0);
+    }
+
+    private static String heading(MessageEditsHistory.Entry entry) {
+        return LocaleController.getString(entry.original ? R.string.EditsHistoryOriginal : R.string.EditedMessage)
+                + " · " + LocaleController.formatDateChat(entry.date) + " "
+                + LocaleController.getInstance().getFormatterPreciseTime().format((long) entry.date * 1000);
+    }
+
+    private static String body(MessageEditsHistory.Entry entry) {
+        return entry.message.message == null || entry.message.message.isEmpty()
+                ? LocaleController.getString(R.string.EditsHistoryMedia) : entry.message.message;
+    }
+
+    private static void showPage(BaseFragment fragment, int account, long did, int mid, long beforeSequence) {
+        MessagesStorage.getInstance(account).loadMessageEditsHistory(did, mid, beforeSequence, page -> {
+            Context context = fragment.getParentActivity();
+            if (context == null || fragment.isFinished || fragment.isPaused() || fragment.getCurrentAccount() != account) return;
+            AlertDialog.Builder builder = new AlertDialog.Builder(context, fragment.getResourceProvider());
+            builder.setTitle(LocaleController.getString(R.string.EditsHistory));
+            builder.setPositiveButton(LocaleController.getString(R.string.Close), null);
+            if (page.entries.isEmpty()) {
+                builder.setMessage(LocaleController.getString(R.string.EditsHistoryEmpty));
+            } else {
+                CharSequence[] items = new CharSequence[page.entries.size()];
+                for (int i = 0; i < items.length; i++) {
+                    MessageEditsHistory.Entry entry = page.entries.get(i);
+                    String text = body(entry);
+                    String preview = text.length() > 240 ? text.substring(0, 240) + "…" : text;
+                    items[i] = heading(entry) + "\n" + preview;
+                }
+                builder.setItems(items, (dialog, which) -> {
+                    MessageEditsHistory.Entry entry = page.entries.get(which);
+                    AlertDialog.Builder version = new AlertDialog.Builder(context, fragment.getResourceProvider());
+                    version.setTitle(heading(entry));
+                    version.setMessage(body(entry));
+                    version.setPositiveButton(LocaleController.getString(R.string.Close), null);
+                    version.setNegativeButton(LocaleController.getString(R.string.Back), (d, w) -> showPage(fragment, account, did, mid, beforeSequence));
+                    fragment.showDialog(version.create());
+                });
+                if (page.hasMore) {
+                    long oldest = page.entries.get(page.entries.size() - 1).sequence;
+                    builder.setNegativeButton(LocaleController.getString(R.string.EditsHistoryOlder), (dialog, which) -> showPage(fragment, account, did, mid, oldest));
+                }
+            }
+            if (beforeSequence > 0) {
+                builder.setNeutralButton(LocaleController.getString(R.string.EditsHistoryLatest), (dialog, which) -> showPage(fragment, account, did, mid, 0));
+            }
+            fragment.showDialog(builder.create());
+        });
+    }
+}
