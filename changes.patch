+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Cells.AccountSelectCell;
+import java.util.ArrayList;
+
+public final class TelegramPlusAccountOrderSheet extends BottomSheet {
+    private final ArrayList<Integer> accounts = TelegramPlusAccountOrder.getAccounts();
+    private ItemTouchHelper drag;
+
+    public static void show(BaseFragment fragment, Runnable changed) {
+        if (fragment.getParentActivity() == null) return;
+        TelegramPlusAccountOrderSheet sheet = new TelegramPlusAccountOrderSheet(fragment.getParentActivity(), fragment.getResourceProvider());
+        fragment.showDialog(sheet, dialog -> { if (changed != null) changed.run(); });
+    }
+    private TelegramPlusAccountOrderSheet(Context context, Theme.ResourcesProvider provider) {
+        super(context, false, provider);
+        setTitle("Reorder accounts");
+        setCanDismissWithSwipe(false);
+        LinearLayout content = new LinearLayout(context);
+        content.setOrientation(LinearLayout.VERTICAL);
+        TextView hint = new TextView(context);
+        hint.setText("Press and drag an account to change its position.");
+        hint.setTextSize(14);
+        hint.setTextColor(Theme.getColor(Theme.key_dialogTextGray, provider));
+        hint.setPadding(dp(20), dp(8), dp(20), dp(12));
+        content.addView(hint, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        RecyclerView list = new RecyclerView(context);
+        list.setLayoutManager(new LinearLayoutManager(context));
+        AccountsAdapter adapter = new AccountsAdapter(context, provider);
+        adapter.setHasStableIds(true);
+        list.setAdapter(adapter);
+        int height = Math.min(dp(Math.max(1, accounts.size()) * 56), AndroidUtilities.displaySize.y / 2);
+        content.addView(list, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, height));
+        drag = new ItemTouchHelper(new ItemTouchHelper.SimpleCallback(ItemTouchHelper.UP | ItemTouchHelper.DOWN, 0) {
+            @Override public boolean onMove(@NonNull RecyclerView recycler, @NonNull RecyclerView.ViewHolder from, @NonNull RecyclerView.ViewHolder to) {
+                int a = from.getAdapterPosition(), b = to.getAdapterPosition();
+                if (a < 0 || b < 0 || a >= accounts.size() || b >= accounts.size()) return false;
+                Integer moved = accounts.remove(a);
+                accounts.add(b, moved);
+                adapter.notifyItemMoved(a, b);
+                TelegramPlusAccountOrder.save(accounts);
+                return true;
+            }
+            @Override public void onSwiped(@NonNull RecyclerView.ViewHolder holder, int direction) {}
+            @Override public boolean isLongPressDragEnabled() { return true; }
+        });
+        drag.attachToRecyclerView(list);
+        TextView done = new TextView(context);
+        done.setText("Done");
+        done.setTextSize(16);
+        done.setTypeface(AndroidUtilities.bold());
+        done.setTextColor(Theme.getColor(Theme.key_dialogTextBlue, provider));
+        done.setGravity(Gravity.CENTER);
+        done.setOnClickListener(view -> dismiss());
+        content.addView(done, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(48)));
+        setCustomView(content);
+    }
+    private class Holder extends RecyclerView.ViewHolder {
+        final AccountSelectCell account;
+        Holder(FrameLayout row, AccountSelectCell cell) { super(row); account = cell; }
+    }
+    private class AccountsAdapter extends RecyclerView.Adapter<Holder> {
+        final Context context;
+        final Theme.ResourcesProvider provider;
+        AccountsAdapter(Context context, Theme.ResourcesProvider provider) { this.context = context; this.provider = provider; }
+        @Override public int getItemCount() { return accounts.size(); }
+        @Override public long getItemId(int position) { return accounts.get(position); }
+        @NonNull @Override public Holder onCreateViewHolder(@NonNull ViewGroup parent, int type) {
+            FrameLayout row = new FrameLayout(context);
+            row.setLayoutParams(new RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(56)));
+            AccountSelectCell cell = new AccountSelectCell(context, false);
+            FrameLayout.LayoutParams cellParams = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(56));
+            cellParams.rightMargin = dp(40);
+            row.addView(cell, cellParams);
+            Holder holder = new Holder(row, cell);
+            ImageView handle = new ImageView(context);
+            handle.setImageResource(R.drawable.list_reorder);
+            handle.setScaleType(ImageView.ScaleType.CENTER);
+            handle.setColorFilter(Theme.getColor(Theme.key_dialogIcon, provider), PorterDuff.Mode.SRC_IN);
+            handle.setContentDescription("Drag to reorder");
+            FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(dp(40), dp(56), Gravity.RIGHT | Gravity.CENTER_VERTICAL);
+            row.addView(handle, params);
+            handle.setOnTouchListener((view, event) -> {
+                if (event.getActionMasked() == MotionEvent.ACTION_DOWN && drag != null) { drag.startDrag(holder); return true; }
+                return false;
+            });
+            return holder;
+        }
+        @Override public void onBindViewHolder(@NonNull Holder holder, int position) { holder.account.setAccount(accounts.get(position), true); }
+    }
+}
