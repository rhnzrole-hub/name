@@ -0,0 +1,61 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+
+/** Display ordering only: account slots, sessions and login timestamps are never changed. */
+public final class TelegramPlusAccountOrder {
+    private TelegramPlusAccountOrder() {}
+    private static SharedPreferences preferences() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("telegram_plus_account_order", Context.MODE_PRIVATE);
+    }
+    private static String identity(int account) {
+        UserConfig config = UserConfig.getInstance(account);
+        return account + ":" + config.getClientUserId() + ":" + config.loginTime;
+    }
+    private static void persist(List<Integer> accounts) {
+        StringBuilder value = new StringBuilder();
+        for (int account : accounts) {
+            if (value.length() > 0) value.append(',');
+            value.append(identity(account));
+        }
+        String stored = value.toString();
+        if (!stored.equals(preferences().getString("order", ""))) preferences().edit().putString("order", stored).apply();
+    }
+    public static synchronized ArrayList<Integer> getAccounts() {
+        HashMap<String, Integer> ranks = new HashMap<>();
+        String stored = preferences().getString("order", "");
+        for (String value : stored.split(",")) if (!value.isEmpty() && !ranks.containsKey(value)) ranks.put(value, ranks.size());
+        ArrayList<Integer> result = new ArrayList<>();
+        for (int account = 0; account < UserConfig.MAX_ACCOUNT_COUNT; account++) {
+            if (UserConfig.getInstance(account).isClientActivated()) result.add(account);
+        }
+        result.sort((a, b) -> {
+            int comparison = Integer.compare(ranks.getOrDefault(identity(a), Integer.MAX_VALUE), ranks.getOrDefault(identity(b), Integer.MAX_VALUE));
+            if (comparison != 0) return comparison;
+            comparison = Integer.compare(UserConfig.getInstance(a).loginTime, UserConfig.getInstance(b).loginTime);
+            return comparison != 0 ? comparison : Integer.compare(a, b);
+        });
+        persist(result);
+        return result;
+    }
+    public static synchronized void sort(ArrayList<Integer> accounts) {
+        ArrayList<Integer> ordered = getAccounts();
+        HashMap<Integer, Integer> ranks = new HashMap<>();
+        for (int i = 0; i < ordered.size(); i++) ranks.put(ordered.get(i), i);
+        accounts.sort((a, b) -> Integer.compare(ranks.getOrDefault(a, Integer.MAX_VALUE), ranks.getOrDefault(b, Integer.MAX_VALUE)));
+    }
+    public static synchronized void save(List<Integer> requested) {
+        ArrayList<Integer> active = getAccounts();
+        HashSet<Integer> valid = new HashSet<>(active);
+        HashSet<Integer> seen = new HashSet<>();
+        ArrayList<Integer> result = new ArrayList<>();
+        for (int account : requested) if (valid.contains(account) && seen.add(account)) result.add(account);
+        for (int account : active) if (seen.add(account)) result.add(account);
+        persist(result);
+    }
+}
