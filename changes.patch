diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/PlusChatFolders.java b/TMessagesProj/src/main/java/org/telegram/messenger/PlusChatFolders.java
new file mode 100644
index 00000000..8cbd3b30
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/PlusChatFolders.java
@@ -0,0 +1,158 @@
+package org.telegram.messenger;
+
+import android.content.SharedPreferences;
+
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Set;
+
+/** Device-local categories. These IDs must never be sent as Telegram cloud filters. */
+public final class PlusChatFolders {
+    public static final int PRIVATE = 100;
+    public static final int GROUPS = 101;
+    public static final int CHANNELS = 102;
+    public static final int BOTS = 103;
+    public static final int FAVORITES = 104;
+    public static final int UNREAD = 105;
+    private static final String FAVORITES_KEY = "plus_favorite_dialogs";
+
+    private final int account;
+    private final ArrayList<MessagesController.DialogFilter> filters = new ArrayList<>();
+
+    public PlusChatFolders(int account) {
+        this.account = account;
+        for (int type = PRIVATE; type <= UNREAD; type++) {
+            MessagesController.DialogFilter filter = new MessagesController.DialogFilter();
+            filter.id = -type;
+            filter.localId = 1_000_000 + type;
+            filters.add(filter);
+        }
+    }
+
+    public static boolean isLocalType(int type) {
+        return type >= PRIVATE && type <= UNREAD;
+    }
+
+    public static boolean isLocalFilter(MessagesController.DialogFilter filter) {
+        return filter != null && isLocalType(-filter.id);
+    }
+
+    public ArrayList<MessagesController.DialogFilter> getFilters() {
+        int[] names = {R.string.PlusPrivateChats, R.string.FilterGroups, R.string.FilterChannels,
+                R.string.FilterBots, R.string.PlusFavorites, R.string.PlusUnread};
+        for (int i = 0; i < filters.size(); i++) {
+            filters.get(i).name = LocaleController.getString(names[i]);
+        }
+        return filters;
+    }
+
+    public static int getIcon(int type) {
+        switch (type) {
+            case PRIVATE: return R.drawable.msg_contacts;
+            case GROUPS: return R.drawable.msg_groups;
+            case CHANNELS: return R.drawable.msg_channel;
+            case BOTS: return R.drawable.msg_bot;
+            case FAVORITES: return R.drawable.msg_fave;
+            default: return R.drawable.msg_markunread;
+        }
+    }
+
+    private SharedPreferences preferences() {
+        return MessagesController.getInstance(account).getMainSettings();
+    }
+
+    private Set<String> favorites() {
+        return new HashSet<>(preferences().getStringSet(FAVORITES_KEY, new HashSet<>()));
+    }
+
+    public boolean areAllFavorites(ArrayList<Long> dialogIds) {
+        Set<String> favorites = favorites();
+        if (dialogIds.isEmpty()) {
+            return false;
+        }
+        for (long id : dialogIds) {
+            if (!favorites.contains(Long.toString(id))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    public void toggleFavorites(ArrayList<Long> dialogIds) {
+        Set<String> favorites = favorites();
+        boolean remove = areAllFavorites(dialogIds);
+        for (long id : dialogIds) {
+            if (DialogObject.isFolderDialogId(id)) {
+                continue;
+            }
+            if (remove) {
+                favorites.remove(Long.toString(id));
+            } else {
+                favorites.add(Long.toString(id));
+            }
+        }
+        preferences().edit().putStringSet(FAVORITES_KEY, favorites).apply();
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogsNeedReload);
+    }
+
+    public ArrayList<TLRPC.Dialog> getDialogs(int type) {
+        MessagesController controller = MessagesController.getInstance(account);
+        Set<String> favorites = type == FAVORITES ? favorites() : null;
+        ArrayList<TLRPC.Dialog> result = new ArrayList<>();
+        // Favorites remain reachable even when their chats are archived.
+        ArrayList<TLRPC.Dialog> source = type == FAVORITES ? controller.getAllDialogs() : controller.getDialogs(0);
+        for (TLRPC.Dialog dialog : source) {
+            if (!(dialog instanceof TLRPC.TL_dialog) && !(dialog instanceof TLRPC.TL_dialogCommunity)) {
+                continue;
+            }
+            if (type == FAVORITES) {
+                if (favorites.contains(Long.toString(dialog.id))) {
+                    result.add(dialog);
+                }
+                continue;
+            }
+            if (type == UNREAD) {
+                if (controller.getDialogUnreadCount(dialog) > 0 || dialog.unread_mark || dialog.unread_mentions_count > 0) {
+                    result.add(dialog);
+                }
+                continue;
+            }
+            long peerId = dialog.id;
+            if (DialogObject.isEncryptedDialog(peerId)) {
+                TLRPC.EncryptedChat chat = controller.getEncryptedChat(DialogObject.getEncryptedChatId(peerId));
+                if (chat == null) {
+                    continue;
+                }
+                peerId = chat.user_id;
+            }
+            if (peerId > 0) {
+                TLRPC.User user = controller.getUser(peerId);
+                if (user != null && (type == BOTS && user.bot || type == PRIVATE && !user.bot)) {
+                    result.add(dialog);
+                }
+            } else if (peerId < 0) {
+                TLRPC.Chat chat = controller.getChat(-peerId);
+                if (chat != null) {
+                    boolean channel = ChatObject.isChannel(chat) && !chat.megagroup && !ChatObject.isCommunity(chat);
+                    if (type == CHANNELS && channel || type == GROUPS && !channel) {
+                        result.add(dialog);
+                    }
+                }
+            }
+        }
+        return result;
+    }
+
+    public int getUnreadCount(int type) {
+        MessagesController controller = MessagesController.getInstance(account);
+        int count = 0;
+        for (TLRPC.Dialog dialog : getDialogs(type)) {
+            if (controller.getDialogUnreadCount(dialog) > 0 || dialog.unread_mark || dialog.unread_mentions_count > 0) {
+                count++;
+            }
+        }
+        return count;
+    }
+}
