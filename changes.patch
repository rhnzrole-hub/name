@@ -0,0 +1,98 @@
+package org.telegram.messenger;
+
+import org.telegram.tgnet.TLRPC;
+import java.util.ArrayList;
+
+/** Local categories; never saved as Telegram server folders. */
+public final class TelegramPlusFolders {
+    public static final String[] TITLES = {"All chats", "Bots", "Users", "Groups", "Supergroups", "Channels"};
+    private TelegramPlusFolders() {}
+
+    public static boolean matches(MessagesController controller, TLRPC.Dialog dialog, int category) {
+        return !(dialog instanceof TLRPC.TL_dialogFolder) && (category == 0 || naturalCategory(controller, dialog) == category);
+    }
+
+    private static int naturalCategory(MessagesController controller, TLRPC.Dialog dialog) {
+        long id = dialog.id;
+        if (DialogObject.isEncryptedDialog(id)) {
+            TLRPC.EncryptedChat encrypted = controller.getEncryptedChat(DialogObject.getEncryptedChatId(id));
+            if (encrypted == null) return -1;
+            id = encrypted.user_id;
+        }
+        if (id > 0) {
+            TLRPC.User user = controller.getUser(id);
+            return user == null ? -1 : user.bot ? 1 : 2;
+        }
+        if (id < 0) {
+            TLRPC.Chat chat = controller.getChat(-id);
+            if (chat == null) return -1;
+            if (ChatObject.isChannel(chat) && !chat.megagroup) return 5;
+            return ChatObject.isPublic(chat) ? 4 : 3;
+        }
+        return -1;
+    }
+
+    public static ArrayList<TLRPC.Dialog> filter(MessagesController controller, ArrayList<TLRPC.Dialog> source, int category) {
+        if (category == 0) return source;
+        ArrayList<TLRPC.Dialog> result = new ArrayList<>();
+        for (TLRPC.Dialog dialog : source) {
+            // Keep the archive entry and upstream ordering, including pinned chats.
+            if (dialog instanceof TLRPC.TL_dialogFolder || matches(controller, dialog, category)) result.add(dialog);
+        }
+        return result;
+    }
+
+    public static ArrayList<TLRPC.Dialog> visibleDialogs(MessagesController controller, ArrayList<TLRPC.Dialog> source,
+            int category, int account, boolean hiddenOnly) {
+        java.util.HashSet<Long> hidden = TelegramPlusHiddenChats.snapshot(account);
+        TelegramPlusFolderMembership.Snapshot membership = TelegramPlusFolderMembership.snapshot(account, category);
+        if (!hiddenOnly && hidden.isEmpty() && membership.isEmpty()) return filter(controller, source, category);
+        ArrayList<TLRPC.Dialog> result = new ArrayList<>();
+        java.util.HashSet<Long> seen = new java.util.HashSet<>();
+        for (TLRPC.Dialog dialog : source) {
+            if (dialog instanceof TLRPC.TL_dialogFolder) {
+                if (!hiddenOnly) result.add(dialog);
+                continue;
+            }
+            if (hidden.contains(dialog.id) == hiddenOnly &&
+                    membership.contains(dialog.id, matches(controller, dialog, category)) && seen.add(dialog.id)) result.add(dialog);
+        }
+        return result;
+    }
+
+    public static int visibleUnreadCount(MessagesController controller, int category, int folderId, int account, boolean hiddenOnly) {
+        return unreadCounts(controller, folderId, account, hiddenOnly)[category];
+    }
+
+    /** All six badges in one pass; no settings lookup or identity strings per dialog. */
+    public static int[] unreadCounts(MessagesController controller, int folderId, int account, boolean hiddenOnly) {
+        int[] counts = new int[6];
+        java.util.HashSet<Long> hidden = TelegramPlusHiddenChats.snapshot(account);
+        TelegramPlusFolderMembership.Snapshot[] membership = TelegramPlusFolderMembership.snapshots(account);
+        java.util.HashSet<Long> seen = hiddenOnly ? new java.util.HashSet<>() : null;
+        ArrayList<TLRPC.Dialog> source = hiddenOnly ? controller.getAllDialogs() : controller.getDialogs(folderId);
+        for (TLRPC.Dialog dialog : source) {
+            if (dialog instanceof TLRPC.TL_dialogFolder || hidden.contains(dialog.id) != hiddenOnly ||
+                    !(controller.getDialogUnreadCount(dialog) > 0 || dialog.unread_mark || dialog.unread_mentions_count > 0) ||
+                    seen != null && !seen.add(dialog.id)) continue;
+            int natural = naturalCategory(controller, dialog);
+            for (int category = 0; category < 6; category++) {
+                if (membership[category].contains(dialog.id, category == 0 || category == natural)) counts[category]++;
+            }
+        }
+        return counts;
+    }
+
+    public static int unreadCount(MessagesController controller, int category) {
+        return unreadCount(controller, category, 0);
+    }
+
+    public static int unreadCount(MessagesController controller, int category, int folderId) {
+        int count = 0;
+        for (TLRPC.Dialog dialog : controller.getDialogs(folderId)) {
+            if (matches(controller, dialog, category) &&
+                    (controller.getDialogUnreadCount(dialog) > 0 || dialog.unread_mark || dialog.unread_mentions_count > 0)) count++;
+        }
+        return count;
+    }
+}
