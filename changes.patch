+            if (remove) {
+                boolean containsSelected = false;
+                for (TLRPC.Dialog dialog : getPlusChatFolders().getDialogs(-filter.id)) {
+                    if (selectedIds.contains(dialog.id)) {
+                        containsSelected = true;
+                        break;
+                    }
+                }
+                if (!containsSelected) {
+                    continue;
+                }
+            }
+            choices.add(filter);
+            labels.add(filter.name);
+            icons.add(PlusChatFolders.getIcon(-filter.id));
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(getParentActivity());
+        builder.setTitle(LocaleController.getString(remove ? R.string.PlusRemoveFromFolder : R.string.PlusAddToFolder));
+        if (choices.isEmpty()) {
+            builder.setMessage(LocaleController.getString(R.string.PlusNoFolderMembership));
+            builder.setPositiveButton(LocaleController.getString(R.string.OK), null);
+        } else {
+            int[] iconIds = new int[icons.size()];
+            for (int i = 0; i < iconIds.length; i++) {
+                iconIds[i] = icons.get(i);
+            }
+            builder.setItems(labels.toArray(new CharSequence[0]), iconIds, (dialog, index) -> {
+                if (onSelected != null) {
+                    onSelected.run();
+                }
+                getPlusChatFolders().setFolderMembership(-choices.get(index).id, ids, !remove);
+            });
+        }
+        showDialog(builder.create());
+    }
