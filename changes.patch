diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/ExpiringMediaRetention.java b/TMessagesProj/src/main/java/org/telegram/messenger/ExpiringMediaRetention.java
new file mode 100644
index 00000000..891a865c
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ExpiringMediaRetention.java
@@ -0,0 +1,39 @@
+package org.telegram.messenger;
+
+import org.telegram.tgnet.TLRPC;
+
+/** Keep received cloud-chat media locally; outgoing and secret-chat media are unchanged. */
+public final class ExpiringMediaRetention {
+    private ExpiringMediaRetention() {}
+
+    public static boolean canKeep(TLRPC.Message message) {
+        if (!(message instanceof TLRPC.TL_message) || message instanceof TLRPC.TL_message_secret
+                || message.out || message.id <= 0 || message.media == null
+                || DialogObject.isEncryptedDialog(MessageObject.getDialogId(message))) {
+            return false;
+        }
+        if (message.media instanceof TLRPC.TL_messageMediaPhoto) {
+            return message.media.photo != null && !(message.media.photo instanceof TLRPC.TL_photoEmpty);
+        }
+        if (message.media instanceof TLRPC.TL_messageMediaDocument) {
+            return message.media.document != null && !(message.media.document instanceof TLRPC.TL_documentEmpty);
+        }
+        return false;
+    }
+
+    public static boolean canBurn(TLRPC.Message message) {
+        return canKeep(message) && message.retainedMediaTtl > 0 && !message.retainedMediaBurned;
+    }
+
+    public static void normalize(TLRPC.Message message) {
+        if (canKeep(message) && message.media.ttl_seconds > 0) {
+            if (message.retainedMediaTtl <= 0) message.retainedMediaTtl = message.media.ttl_seconds;
+            message.media.ttl_seconds = 0;
+            // Photo and document media both encode ttl_seconds with flag bit 2.
+            message.media.flags &= ~4;
+            message.ttl = 0;
+            message.destroyTime = 0;
+            message.destroyTimeMillis = 0;
+        }
+    }
+}
